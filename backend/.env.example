# Conexión a MySQL: mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:@localhost:3306/feriabot?charset=utf8mb4

# Clave para firmar los tokens. En producción usar una larga y aleatoria:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave
JWT_EXPIRE_MINUTES=720

# Orígenes del frontend que pueden llamar a la API (lista JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Usuario organizador que se crea al arrancar si no existe
ADMIN_EMAIL=admin@feriabot.com
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Organización

# Habilita POST /demo/reiniciar (borra todo y recarga los datos de demostración)
DEMO_MODE=true

# Correo saliente para los códigos de verificación (Gmail).
# SMTP_PASSWORD es una "contraseña de aplicación" de Google, NO tu contraseña normal:
#   https://myaccount.google.com/apppasswords  (requiere verificación en 2 pasos activada)
# Mientras SMTP_USER esté vacío no se envía nada y el código se muestra en la consola del backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=FeriaBot Pro
CODIGO_MINUTOS=10

# Versión vigente de la política de privacidad (se guarda con la aceptación de cada visitante)
POLITICA_VERSION=2026-10

# Datos del responsable del tratamiento que aparecen en los textos legales (LOPDP).
RESPONSABLE_NOMBRE=FeriaBot Pro
RESPONSABLE_RUC=
RESPONSABLE_DIRECCION=Quito, Ecuador
RESPONSABLE_EMAIL=privacidad@feriabot.com
RESPONSABLE_TELEFONO=
