# Conexión a MySQL: mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:@localhost:3306/feriabot?charset=utf8mb4
# MySQL en la nube con SSL (p. ej. Aiven): pega aquí el contenido del CA certificate. Vacío = sin SSL.
DB_SSL_CA=

# Clave para firmar los tokens. En producción usar una larga y aleatoria:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave
JWT_EXPIRE_MINUTES=720

# Orígenes del frontend que pueden llamar a la API (lista JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Usuario organizador que se crea al arrancar si no existe
ADMIN_EMAIL=admin@feriabot.com
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Organización

# Habilita POST /demo/reiniciar (borra todo y recarga los datos de demostración)
DEMO_MODE=true

# Correo saliente para los códigos de verificación (Gmail).
# SMTP_PASSWORD es una "contraseña de aplicación" de Google, NO tu contraseña normal:
#   https://myaccount.google.com/apppasswords  (requiere verificación en 2 pasos activada)
# Mientras SMTP_USER esté vacío no se envía nada y el código se muestra en la consola del backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=FeriaBot Pro
CODIGO_MINUTOS=10
# Diferencia con UTC de la hora local, para agrupar las estadísticas por día y hora (Ecuador: -5)
ZONA_HORARIA_UTC=-5
# Producción: redirige http a https y envía la cabecera HSTS (en desarrollo, false)
FORZAR_HTTPS=false
# Límite de intentos por IP en inicios de sesión, códigos por correo y registro (anti spam)
LIMITES_ACTIVOS=true
# Dirección pública del frontend: enlaces de los correos, robots.txt y sitemap.xml
FRONTEND_URL=http://localhost:5173

# Versión vigente de la política de privacidad (se guarda con la aceptación de cada visitante)
POLITICA_VERSION=2026-10

# Datos del responsable del tratamiento que aparecen en los textos legales (LOPDP).
RESPONSABLE_NOMBRE=FeriaBot Pro
RESPONSABLE_RUC=
RESPONSABLE_DIRECCION=Quito, Ecuador
RESPONSABLE_EMAIL=privacidad@feriabot.com
RESPONSABLE_TELEFONO=

# Pago con tarjeta (PayPhone Developer > tu aplicación). Vacíos = solo transferencia.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Solo desarrollo: cajita de prueba sin cuenta de PayPhone (no cobra). Nunca en producción.
PAYPHONE_DEMO=false

# Cifrado AES-256-GCM de teléfonos, comprobantes e IP (32 bytes en base64). Generar con:
#   py -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ¡Respáldala! Si se pierde, los datos cifrados no se pueden recuperar.
CLAVE_CIFRADO=
# Opcional (producción con varios procesos): Redis para los límites de intentos. Requiere: pip install redis
REDIS_URL=

# «produccion» al publicar: no crea cuentas con contraseñas de ejemplo, exige JWT_SECRET y CLAVE_CIFRADO fuertes.
ENTORNO=desarrollo
# Primer Super Administrador (solo si no existe ninguno). En producción usa una contraseña fuerte propia, o deja
# estos valores vacíos y créalo con: py -m app.crear_superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NOMBRE=FeriaBot Pro
