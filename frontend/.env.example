# URL del backend FastAPI.
#   /api                    -> pasa por el proxy de Vite hacia localhost:8000 (un solo puerto; sirve para túneles)
#   http://localhost:8000   -> llama al backend directo (hay que tenerlo en CORS_ORIGINS)
# Si se deja vacío se usa el mismo host desde el que se abre la app, puerto 8000.
VITE_API_URL=/api
