# URL del backend FastAPI.
#   /api                    -> pasa por el proxy de Vite hacia localhost:8000 (un solo puerto; sirve para túneles)
#   http://localhost:8000   -> llama al backend directo (hay que tenerlo en CORS_ORIGINS)
# Si se deja vacío se usa el mismo host desde el que se abre la app, puerto 8000.
VITE_API_URL=/api

# Dirección pública del sitio (URL canónica, Open Graph y datos estructurados). Vacío = la dirección actual.
VITE_SITE_URL=

# Analítica sin cookies (solo en el build de producción). VITE_ANALITICA = umami o plausible.
#   umami     -> VITE_ANALITICA_ID = website id que da Umami
#   plausible -> VITE_ANALITICA_ID = dominio registrado en Plausible (ej. feriabot.ec)
# VITE_ANALITICA_SRC es opcional: la URL del script si lo alojan ustedes.
VITE_ANALITICA=
VITE_ANALITICA_ID=
VITE_ANALITICA_SRC=
